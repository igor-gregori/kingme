{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "kingme",
  "compatibility_date": "2026-10-01",
  // Site 100% estático: a Cloudflare serve a pasta dist sem nenhum código de servidor.
  // Domínio próprio: a Cloudflare cria o DNS e o certificado HTTPS automaticamente.
  "routes": [{ "pattern": "kingme.igreg.dev", "custom_domain": true }],
  "assets": {
    "directory": "./dist",
    // "/como-funciona" é uma rota do React, então todo caminho desconhecido devolve o index.html.
    "not_found_handling": "single-page-application"
  }
}
